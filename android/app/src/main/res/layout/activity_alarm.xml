<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_gradient"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <!-- اوپر موجودہ وقت (Current Time) -->
    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:alpha="0.85"
        android:fontFamily="sans-serif-medium"
        tools:text="8:00 AM"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- بیچ میں دھڑکتا ہوا آئیکن (Pulsing Icon) -->
    <!-- Snooze button ke top se aur tvCurrentTime ke bottom se chain hoga,
         taake yeh dono ke darmiyan hamesha centered rahe aur kabhi overlap na ho -->
    <FrameLayout
        android:id="@+id/iconArea"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentTime"
        app:layout_constraintBottom_toTopOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp">

        <View
            android:id="@+id/pulseOuter"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_circle" />

        <View
            android:id="@+id/pulseInner"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_circle" />

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_medicine" />
    </FrameLayout>

    <!-- میڈیسن کا نام -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Metformin"
        app:layout_constraintTop_toBottomOf="@id/iconArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- میڈیسن کی خوراک -->
    <TextView
        android:id="@+id/tvDose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:alpha="0.9"
        android:textSize="16sp"
        android:gravity="center"
        tools:text="500 mg · 1 tablet"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- شیڈیول ٹائم (اگر ہو) -->
    <TextView
        android:id="@+id/tvScheduledTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:alpha="0.85"
        android:textSize="14sp"
        android:background="@drawable/bg_pill_outline"
        tools:text="Scheduled for 2:32 AM"
        app:layout_constraintTop_toBottomOf="@id/tvDose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stop Button -->
    <Button
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_stop"
        android:text="Stop"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvScheduledTime"
        app:layout_constraintBottom_toTopOf="@id/btnSnooze"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="1" />

    <!-- Snooze Button -->
    <Button
        android:id="@+id/btnSnooze"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_snooze"
        android:text="Snooze 10 min"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/btnStop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>